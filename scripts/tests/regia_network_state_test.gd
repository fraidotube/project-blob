extends SceneTree
var failures := 0
func _initialize() -> void:
	call_deferred("run")
func check(value: bool, message: String) -> void:
	if not value:
		failures += 1
		push_error("NETWORK_STATE: " + message)
func run() -> void:
	var inventory := root.get_node("InventoryManager")
	inventory.clear()
	var early = load("res://scripts/systems/regia_network_state.gd").new()
	root.add_child(early)
	check(early.take_charger() and not early.connect_charger() and inventory.has_item(&"regia_charger"), "Charger-first pickup not preserved")
	check(early.take_laptop() and early.place_laptop(), "Charger-first laptop placement failed")
	check(early.use_laptop() == "Caricatore collegato." and early.laptop_open and early.charger_connected and not early.laptop_on, "First E with charger did not open and connect")
	early.free()
	inventory.clear()
	var state = load("res://scripts/systems/regia_network_state.gd").new()
	root.add_child(state)
	check(not state.connect_charger(), "Charger connected without laptop")
	check(not state.place_laptop(), "Laptop placed without inventory item")
	check(not state.toggle_cable("switch"), "Router connected without PC or cable")
	check(state.take_cable() and state.take_cable() and not state.take_cable(), "Two cable limit broken")
	check(state.take_laptop() and not state.take_laptop(), "Duplicate laptop pickup")
	check(not state.toggle_cable("pc"), "Cable connected to laptop still in inventory")
	check(state.toggle_cable("switch"), "Switch-first connection failed")
	check(not state.online, "Unconfigured router online")
	check(state.place_laptop(), "Laptop placement failed")
	check(not inventory.has_item(&"regia_laptop"), "Placed laptop duplicated in inventory")
	check(state.use_laptop().contains("scarico") and state.laptop_open, "Flat laptop did not open")
	check(not state.connect_charger(), "Uncollected charger connected")
	check(state.take_charger() and not state.take_charger() and inventory.has_item(&"regia_charger"), "Charger pickup missing or duplicate")
	check(state.connect_charger(), "Charger failed after placement")
	check(not inventory.has_item(&"regia_charger"), "Connected charger remains in inventory")
	check(not state.local_network(), "Network works without power")
	state.set_power(true)
	check(state.use_laptop().contains("acceso"), "Laptop failed to boot")
	check(state.use_laptop() == "terminal", "Second powered interaction failed")
	check(not state.shutdown_laptop() and state.laptop_on and state.status.contains("non posso spegnerlo"), "Premature shutdown allowed")
	check(not state.recover_laptop(), "Laptop recovered before completion")
	check(state.toggle_cable("pc") and state.local_network(), "PC local network failed")
	check(not state.configure_pppoe("wrong", "wrong"), "Wrong PPPoE accepted")
	check(state.configure_pppoe("narcisolo", "ottavonano"), "Valid PPPoE refused")
	check(not state.online, "Online before negotiation")
	await create_timer(3.2).timeout
	check(state.online and not state.alien_connected(), "PPPoE or radio-off gating wrong")
	state.configure_wifi(true, true, "secret")
	check(not state.alien_connected(), "Protected WLAN unlocks alien connection")
	state.configure_wifi(true, false, "")
	check(state.alien_connected(), "Open WLAN with uplink not connected")
	check(state.toggle_cable("switch") and not state.online and not state.alien_connected(), "Removed uplink remains Online")
	check(inventory.has_item(&"network_cable") and not state.take_cable(), "Recovered cable violates total stock limit")
	check(state.toggle_cable("switch"), "Reconnection failed")
	await create_timer(3.2).timeout
	for i in [0, 0, 0, 0]: state.press_symbol(i)
	check(not state.unlocked and state.entered.is_empty(), "Wrong code unlocks or sticks")
	for i in state.PASSWORD: state.press_symbol(i)
	check(state.unlocked, "Correct code did not latch")
	state.set_power(false)
	check(state.unlocked and not state.online and state.pppoe_valid, "Power loss resets puzzle or configuration")
	var snapshot: Dictionary = state.snapshot()
	var restored = load("res://scripts/systems/regia_network_state.gd").new()
	root.add_child(restored)
	restored.restore(snapshot)
	check(restored.unlocked and restored.pc_link and restored.switch_link and restored.laptop_placed, "Intermediate snapshot lost")
	check(state.shutdown_laptop() and state.laptop_shutdown and not state.laptop_open and not state.laptop_on, "Completed laptop did not shut and close")
	check(state.recover_laptop() and inventory.has_item(&"regia_laptop") and inventory.has_item(&"regia_charger") and inventory.has_item(&"network_cable"), "Laptop, charger or PC cable not recovered")
	check(not state.recover_laptop() and not state.pc_link and state.switch_link, "Repeated pickup or switch connection lost")
	check(not state.place_laptop() and state.status == "Non c'è più bisogno ora." and inventory.has_item(&"regia_laptop"), "Completed puzzle consumed laptop again")
	restored.restore(state.snapshot())
	check(restored.laptop_recovered and restored.laptop_shutdown and not restored.charger_connected and not restored.laptop_placed, "Packed state lost on restore")
	var legacy = load("res://scripts/systems/regia_network_state.gd").new()
	root.add_child(legacy)
	snapshot.erase("charger_collected")
	snapshot.erase("laptop_shutdown")
	snapshot.erase("laptop_recovered")
	legacy.restore(snapshot)
	check(legacy.charger_collected and legacy.charger_connected and not legacy.laptop_shutdown, "Old connected charger snapshot incompatible")
	legacy.free()
	for definition: Resource in inventory.definitions.values(): check(definition.icon != null, "Inventory icon missing")
	var glyphs = load("res://scripts/ui/regia_alien_glyphs.gd")
	var font: Font = glyphs.font()
	for code in glyphs.CODES: check(font.has_char(code), "Alien alphabet glyph missing")
	state.free()
	restored.free()
	print("REGIA_NETWORK_STATE_TEST failures=", failures)
	quit(0 if failures == 0 else 1)
