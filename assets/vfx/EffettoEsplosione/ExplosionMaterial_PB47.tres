width = 64

; Corrected hot-core emission ramp.
; Key point:
; the old/original ramp's FIRST defined colour was near-white at ~0.382.
; GradientTexture clamps all values below that first offset to that first
; colour. In Godot 4 this made low-energy smoke pixels emit WHITE light.
;
; We explicitly define BLACK for the low-energy region, then transition
; into the hot white/orange/red core, and finally back to black.
[sub_resource type="Gradient" id="Gradient_emission_color"]
offsets = PackedFloat32Array(
	0.0,
	0.30,
	0.38,
	0.46,
	0.55,
	0.61,
	1.0
)
colors = PackedColorArray(
	0, 0, 0, 1,
	0, 0, 0, 1,
	0.95, 0.22, 0.04, 1,
	1.0, 0.72, 0.24, 1,
	1.0, 0.08, 0.01, 1,
	0, 0, 0, 1,
	0, 0, 0, 1
)

[sub_resource type="GradientTexture1D" id="GradientTexture_emission_color"]
gradient = SubResource("Gradient_emission_color")
width = 256

